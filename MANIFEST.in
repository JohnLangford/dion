# setup.py reads these at build time to populate install_requires and
# extras_require. Without them in the sdist, `read_requirements` finds nothing,
# warns, and returns an empty list -- so building from the sdist yields a wheel
# that declares no dependencies at all. See tests/test_packaging.py.
include requirements_dion.txt
include requirements_dev.txt
include requirements_train.txt
include requirements_gns.txt
include LICENSE
include NOTICE.md
include README.md
include CHANGELOG.md
